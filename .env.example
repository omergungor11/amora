# Bu dosyayı .env olarak çoğalt. Anahtarlar SADECE sunucuda kullanılır,
# tarayıcıya asla gönderilmez.

# ── Ücretsiz varsayılan: Google Gemini ────────────────────────────────
# Ücretsiz key (kredi kartı gerekmez): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Opsiyonel: Anthropic Claude (fallback) ────────────────────────────
ANTHROPIC_API_KEY=

# Sağlayıcı seçimi: "gemini" | "anthropic". Boş bırakılırsa hangi key
# varsa o kullanılır (Gemini öncelikli).
CHAT_PROVIDER=gemini

# Opsiyonel: sohbet modeli. Gemini varsayılanı gemini-2.5-flash.
# (Anthropic için örn: claude-haiku-4-5)
CHAT_MODEL=gemini-2.5-flash

# Opsiyonel: backend portu
PORT=8787

# ── Opsiyonel: Firebase (kalıcılık + auth) ────────────────────────────
# Boş bırakılırsa uygulama yerel store'larla çalışır (kalıcılık kapalı).
# Firebase Console → Project settings → "Your apps" (Web) config'inden al.
# Bu değerler herkese açıktır (frontend'e gider); güvenliği Firestore Rules
# sağlar (firestore.rules). VITE_ önekli olmalı.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
