rules_version = '2';

// Amora — Firestore Security Rules
//
// Two surfaces:
//  • PRIVATE per-user subtree (full profile, swipes, economy, AI-seed chats)
//  • PUBLIC matching graph for real user↔user discovery & chat
//
//   users/{uid}/**                 -> private; only the owner
//   profiles/{uid}                 -> public card-safe subset; any signed-in read
//   likes/{likeId}                 -> directional like; from==me to create
//   matches/{matchId}              -> { users:[a,b] }; only participants
//   matches/{matchId}/messages/*   -> shared thread; only participants

service cloud.firestore {
  match /databases/{database}/documents {

    // ── private user subtree ──────────────────────────────────────
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── public, card-safe profiles ────────────────────────────────
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── directional likes (A → B) ─────────────────────────────────
    match /likes/{likeId} {
      allow read: if request.auth != null &&
        (resource.data.from == request.auth.uid ||
         resource.data.to == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.from == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.from == request.auth.uid;
    }

    // ── mutual matches + shared message threads ───────────────────
    match /matches/{matchId} {
      allow read, update: if request.auth != null &&
        request.auth.uid in resource.data.users;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.users;

      match /messages/{msgId} {
        allow read: if request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/matches/$(matchId)).data.users;
        // sender must be a participant, address a participant, and not be
        // blocked by the recipient (blocks/{recipient}_{sender})
        allow create: if request.auth != null &&
          request.resource.data.from == request.auth.uid &&
          request.auth.uid in
            get(/databases/$(database)/documents/matches/$(matchId)).data.users &&
          request.resource.data.to in
            get(/databases/$(database)/documents/matches/$(matchId)).data.users &&
          !exists(/databases/$(database)/documents/blocks/$(request.resource.data.to + '_' + request.auth.uid));
      }
    }

    // ── blocks (top-level so message rules can check them) ────────
    match /blocks/{id} {
      allow read, delete: if request.auth != null &&
        resource.data.blocker == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.blocker == request.auth.uid;
    }

    // ── reports (moderation) — reporter writes; no client reads ───
    match /reports/{id} {
      allow create: if request.auth != null &&
        request.resource.data.reporter == request.auth.uid;
    }

    // Everything else is denied by default.
  }
}
